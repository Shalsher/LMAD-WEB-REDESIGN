---
/**
 * Sticky header.
 *
 * Replaces the current 37-link / 10-items-under-Press-Room navbar with the
 * 5 groups from the brief, plus the reader controls the 55+ audience needs.
 */
const { current = '' } = Astro.props as { current?: string };

const NAV = [
  { label: 'The Movement',    href: '/#movement' },
  { label: 'Programs',        href: '/#programs' },
  { label: 'Impact & Stories', href: '/stories', key: 'stories' },
  { label: 'Experience It',   href: '/#experience' },
];
---

<header class="hdr">
  <div class="hdr__inner page">
    <a href="/" class="hdr__brand" aria-label="Let's Make A Difference — home">
      <img
        src="/brand/lmad-logo-header.png"
        alt="Let's Make A Difference"
        width="149" height="48"
        fetchpriority="high"
      />
    </a>

    <nav class="hdr__nav" aria-label="Main">
      <ul>
        {NAV.map((item) => (
          <li>
            <a href={item.href} aria-current={item.key && item.key === current ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="hdr__tools">
      <!-- Reader controls: the brief asks for A-/A+ and contrast in the sticky header -->
      <div class="rdr" role="group" aria-label="Reader settings">
        <button type="button" data-text-step="down" class="rdr__btn" aria-label="Decrease text size">A<span>−</span></button>
        <button type="button" data-text-step="up" class="rdr__btn" aria-label="Increase text size">A<span>+</span></button>
        <button type="button" data-theme-toggle class="rdr__btn rdr__btn--theme" aria-pressed="false" aria-label="Switch to dark theme">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>
          </svg>
        </button>
      </div>

      <a href="/#verify" class="btn btn--ghost hdr__verify">Verify Certificate</a>
      <a href="/#join" class="btn btn--primary hdr__join">Join Next Conference</a>

      <button type="button" class="hdr__burger" aria-expanded="false" aria-controls="mobile-nav" aria-label="Open menu">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <div class="hdr__mobile" id="mobile-nav" hidden>
    <nav aria-label="Mobile">
      <ul>
        {NAV.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        <li><a href="/#verify">Verify Certificate</a></li>
      </ul>
    </nav>
    <a href="/#join" class="btn btn--primary">Join Next Conference</a>
  </div>
</header>

<style>
  .hdr {
    position: sticky; top: 0; z-index: 100;
    background: color-mix(in srgb, var(--parchment) 88%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--hairline);
  }
  .hdr__inner {
    display: flex; align-items: center; gap: var(--s-5);
    min-height: 76px;
  }
  .hdr__brand {
    flex-shrink: 0; display: block; line-height: 0;
    /* the mark is four colour blocks on white — keep its own ground in dark mode */
    background: #fff; padding: 6px 8px; border-radius: var(--r-md);
  }
  .hdr__brand img { height: 40px; width: auto; }

  .hdr__nav { margin-inline-start: auto; }
  .hdr__nav ul { display: flex; gap: var(--s-5); list-style: none; padding: 0; }
  .hdr__nav a {
    display: block; padding: var(--s-2) 0;
    color: var(--ink); text-decoration: none;
    font-size: var(--t-sm); font-weight: 600;
    border-bottom: 2px solid transparent;
  }
  .hdr__nav a:hover { color: var(--link); border-bottom-color: var(--brand-blue); }
  .hdr__nav a[aria-current='page'] { color: var(--link); border-bottom-color: var(--brand-blue); }

  .hdr__tools { display: flex; align-items: center; gap: var(--s-3); }

  .rdr { display: flex; gap: 2px; padding: 3px; background: var(--parchment-sunk); border-radius: var(--r-full); }
  .rdr__btn {
    display: inline-flex; align-items: center; justify-content: center;
    min-width: 44px; min-height: 44px;   /* real tap targets */
    border: 0; background: transparent; border-radius: var(--r-full);
    color: var(--ink); font-size: var(--t-sm); font-weight: 700; cursor: pointer;
  }
  .rdr__btn span { font-size: 0.75em; margin-left: 1px; }
  .rdr__btn:hover { background: var(--surface); }
  .rdr__btn[aria-pressed='true'] { background: var(--surface); }

  .hdr__burger { display: none; }

  @media (max-width: 1100px) {
    .hdr__nav, .hdr__verify { display: none; }
    .hdr__nav { margin-inline-start: 0; }
    .hdr__tools { margin-inline-start: auto; }
    .hdr__burger {
      display: inline-flex; flex-direction: column; justify-content: center; gap: 5px;
      min-width: 48px; min-height: 48px; padding: 0 12px;
      background: transparent; border: 1px solid var(--hairline); border-radius: var(--r-md);
      cursor: pointer;
    }
    .hdr__burger span { display: block; height: 2px; background: var(--ink); border-radius: 2px; }
  }
  @media (max-width: 640px) {
    .hdr__join { display: none; }
    .hdr__inner { gap: var(--s-3); }
  }

  .hdr__mobile {
    border-top: 1px solid var(--hairline);
    padding: var(--s-4) var(--gutter) var(--s-6);
    background: var(--parchment);
  }
  .hdr__mobile[hidden] { display: none; }
  .hdr__mobile ul { list-style: none; padding: 0; margin-bottom: var(--s-4); }
  .hdr__mobile a {
    display: block; padding: var(--s-4) 0;
    font-size: var(--t-lg); font-weight: 600; color: var(--ink); text-decoration: none;
    border-bottom: 1px solid var(--hairline);
  }
  .hdr__mobile > .btn { width: 100%; }
</style>

<script>
  // --- reader preferences -------------------------------------------------
  // Persisted per visitor. Wrapped because storage throws in private mode.
  const STEPS = ['normal', 'large', 'xlarge'] as const;
  const root = document.documentElement;

  const read = (k: string) => { try { return localStorage.getItem(k); } catch { return null; } };
  const write = (k: string, v: string) => { try { localStorage.setItem(k, v); } catch { /* no-op */ } };

  function applyText(step: string) {
    if (step === 'normal') root.removeAttribute('data-text-size');
    else root.setAttribute('data-text-size', step);
  }

  function applyTheme(theme: string | null) {
    const btn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
    if (theme) root.setAttribute('data-theme', theme);
    else root.removeAttribute('data-theme');
    const isDark = theme === 'dark'
      || (!theme && window.matchMedia('(prefers-color-scheme: dark)').matches);
    btn?.setAttribute('aria-pressed', String(isDark));
    btn?.setAttribute('aria-label', isDark ? 'Switch to light theme' : 'Switch to dark theme');
  }

  applyText(read('lmad:text') ?? 'normal');
  applyTheme(read('lmad:theme'));

  document.querySelectorAll<HTMLButtonElement>('[data-text-step]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const cur = read('lmad:text') ?? 'normal';
      const i = STEPS.indexOf(cur as typeof STEPS[number]);
      const next = STEPS[Math.min(STEPS.length - 1, Math.max(0, i + (btn.dataset.textStep === 'up' ? 1 : -1)))];
      applyText(next); write('lmad:text', next);
    });
  });

  document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
    const isDark = root.getAttribute('data-theme') === 'dark'
      || (!root.hasAttribute('data-theme') && window.matchMedia('(prefers-color-scheme: dark)').matches);
    const next = isDark ? 'light' : 'dark';
    applyTheme(next); write('lmad:theme', next);
  });

  // --- mobile menu --------------------------------------------------------
  const burger = document.querySelector<HTMLButtonElement>('.hdr__burger');
  const panel = document.getElementById('mobile-nav');
  burger?.addEventListener('click', () => {
    const open = burger.getAttribute('aria-expanded') === 'true';
    burger.setAttribute('aria-expanded', String(!open));
    burger.setAttribute('aria-label', open ? 'Open menu' : 'Close menu');
    if (panel) panel.hidden = open;
  });
</script>
